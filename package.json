{
  "name": "videoslim-desktop",
  "productName": "VideoSlim Desktop",
  "version": "1.4.0",
  "description": "로컬 영상 압축 데스크톱 앱 (FFmpeg 기반, 오프라인 처리)",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node tests/fixtures/generate.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && xvfb-run -a playwright test -c playwright.config.ts",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:win": "npm run fetch:ffmpeg && npm run build && electron-builder --win --x64",
    "pack:linux-dir": "npm run build && electron-builder --linux dir",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg-win.mjs",
    "verify:win": "node scripts/verify-win-package.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "author": "VideoSlim Desktop contributors",
  "homepage": "https://github.com/265mmsize/EZVideoCompression",
  "build": {
    "appId": "com.videoslim.desktop",
    "productName": "VideoSlim Desktop",
    "copyright": "Copyright (c) VideoSlim Desktop contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/binaries",
        "to": "binaries",
        "filter": [
          "**/*",
          "!**/README.md"
        ]
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Video"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "identity": null
    }
  }
}
